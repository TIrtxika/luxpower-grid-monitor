# LuxPower Bot Environment Variables

# Telegram Bots
PUBLIC_BOT_TOKEN=your_public_bot_token_here
PRIVATE_BOT_TOKEN=your_private_bot_token_here
OWNER_CHAT_ID=your_telegram_user_id

# RPi API
RPI_API_URL=http://10.10.0.2:8080
RPI_API_TOKEN=your_rpi_api_token_here

# Database
DATABASE_URL=postgresql://luxpower:your_password_here@localhost:5432/luxpower

# Optional: Public channel for alerts
# PUBLIC_CHANNEL_ID=-1001234567890

# Logging
LOG_LEVEL=INFO

# LuxPower Bot Environment Variables

# Telegram Bots
PUBLIC_BOT_TOKEN=your_public_bot_token_here
PRIVATE_BOT_TOKEN=your_private_bot_token_here
OWNER_CHAT_ID=your_telegram_user_id

# RPi API
RPI_API_URL=http://10.10.0.2:8080
RPI_API_TOKEN=your_rpi_api_token_here

# Database
DATABASE_URL=postgresql://luxpower:your_password_here@localhost:5432/luxpower

# Optional: Public channel for alerts
# PUBLIC_CHANNEL_ID=-1001234567890

# Optional: owner alerts outside Telegram via ntfy (empty topic = disabled)
# Use a long random topic — anyone who knows it can read the alerts
# NTFY_URL=https://ntfy.sh
# NTFY_TOPIC=luxpower-<long-random-string>
# NTFY_TOKEN=

# Optional: external watchdog (healthchecks.io check: period 1 min, grace 5 min)
# HEALTHCHECK_URL=https://hc-ping.com/<uuid>

# Optional: battery forecast and low-battery warnings
# BATTERY_EMPTY_SOC=10
# BATTERY_ALERT_LEVELS=30,15

# Optional: DTEK planned outage schedule via YASNO (empty group = disabled)
# Group of the address, e.g. 16.1; street name + house number enable the weekly group check
# DTEK_GROUP=16.1
# YASNO_STREET=Руданського
# YASNO_HOUSE=3А
# SCHEDULE_REMIND_MINUTES=30

# Logging
LOG_LEVEL=INFO
